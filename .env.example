# Copia este archivo a .env.local y rellena los valores. NUNCA subas .env.local al repo.

# URL pública de la web (sin barra final). En producción: https://inmueblesconester.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "true" mientras la web viva en *.vercel.app sin dominio: añade noindex a todas las páginas.
NEXT_PUBLIC_NOINDEX=true

# Formulario → n8n (workflow ester-lead-v1). El navegador nunca ve esta URL.
N8N_LEAD_WEBHOOK_URL=https://TU-N8N/webhook/ester-lead-v1
# Secreto compartido: la web lo manda en la cabecera X-Lead-Secret y n8n lo comprueba.
N8N_LEAD_SECRET=cambia-esto-por-una-cadena-larga-aleatoria

# Cloudflare Turnstile (antispam invisible). Claves de prueba que siempre pasan:
# site 1x00000000000000000000AA · secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Analítica y píxel (solo cargan tras aceptar cookies). Vacíos = no se cargan.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=

# WhatsApp de Ester en formato internacional sin "+" (ej. 34600000000). Vacío = botones ocultos.
NEXT_PUBLIC_WHATSAPP_NUMBER=
